{
  "name": "jfm-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "preview": "tsx scripts/preview.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "import": "tsx scripts/import.ts",
    "import:reference": "tsx scripts/import-reference.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:layout": "tsx scripts/layout-check.tsx",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm audit",
    "readiness": "tsx scripts/readiness.ts"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "express": "5.1.0",
    "ical.js": "2.2.1",
    "jose": "6.1.0",
    "luxon": "3.7.2",
    "pdfkit": "0.20.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/luxon": "3.7.1",
    "@types/node": "24.5.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "typescript": "5.9.2",
    "vite": "7.3.5"
  }
}
